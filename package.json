{
  "name": "neon-city-1986",
  "version": "0.2.3",
  "description": "NEON CITY: 1986 — jogo de ação em mundo aberto, original, inspirado nos anos 80 (Three.js).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:testmap": "node tools/test-map/build-test-map.mjs",
    "test:city": "node --test tools/test-map/coastal-city.test.mjs",
    "test:merged": "node --test tools/test-map/merged-world.test.mjs",
    "test:assets": "node --test tools/protagonist/assets.test.mjs",
    "test:hud": "node --test tools/hud/status.test.mjs",
    "test:police": "node --test tools/police/police.test.mjs",
    "test:ai": "node --test tools/ai/citizens.test.mjs tools/ai/simulation.test.mjs",
    "test:ocean": "node --test tools/ocean/ocean.test.mjs",
    "test:customs": "node --test tools/vehicles/customization.test.mjs",
    "test:destruction": "node --test tools/test-map/destruction.test.mjs tools/test-map/city-destruction-integration.test.mjs",
    "desktop": "vite build && electron .",
    "desktop:dev": "node tools/desktop/dev.mjs",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "icon": "node tools/desktop/make-icon.mjs",
    "dist:linux": "vite build && electron-builder --linux AppImage deb",
    "test:neon": "node --test tools/vehicles/neon-motor.test.mjs",
    "build:vehicles": "blender --background --factory-startup --python tools/blender/neon_motor/run.py -- --all --render",
    "test:radio": "node --test tools/radio/radio.test.mjs",
    "build:radio": "node tools/radio/build-radio.mjs",
    "test:moto": "node --test tools/vehicles/neon-moto.test.mjs",
    "test:mechanics": "node --test tools/vehicles/mechanics-core.test.mjs tools/vehicles/powertrain-integration.test.mjs tools/vehicles/mechanics-neon.test.mjs",
    "build:motos": "blender --background --factory-startup --python tools/blender/neon_moto/run_moto.py -- --all --render",
    "build:vice": "python tools/vice-city/convert.py --all",
    "test:vice": "node --test tools/vice-city/collision.test.mjs tools/vice-city/single-map.test.mjs tools/vice-city/water-fallback.test.mjs",
    "test:interface": "node --test tools/hud/radar-menu.test.mjs tools/hud/waypoint-gauge.test.mjs",
    "test:desktop": "node --test tools/desktop/local-map.test.cjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "NEON CITY dev",
    "email": "vitinhopessoal@users.noreply.github.com"
  },
  "build": {
    "appId": "com.neoncity.game1986",
    "productName": "NEON CITY 1986",
    "copyright": "NEON CITY: 1986",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NEON CITY 1986",
      "artifactName": "NEON-CITY-1986-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NEON-CITY-1986-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "neon-city-1986",
      "synopsis": "Jogo de ação em mundo aberto, anos 80",
      "artifactName": "NEON-CITY-1986-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true,
      "maintainer": "NEON CITY dev <vitinhopessoal@users.noreply.github.com>"
    },
    "deb": {
      "artifactName": "NEON-CITY-1986-${version}-linux-${arch}.${ext}"
    }
  },
  "desktopName": "neon-city-1986.desktop",
  "homepage": "https://github.com/vitinhopessoal/neon-city-1986"
}
